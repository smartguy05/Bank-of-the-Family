# Copy to apps/api/.env for local development
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_URL=postgres://botf:botf@127.0.0.1:5432/botf
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Authentik OIDC (parents)
AUTHENTIK_ISSUER=https://auth.example.com/application/o/bank-of-the-family/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_PARENT_GROUP=bank-parents
# Authentik API (create co-parent users from invites)
AUTHENTIK_API_URL=https://auth.example.com/api/v3
AUTHENTIK_API_TOKEN=
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Android TWA: comma-separated SHA-256 signing fingerprints for /.well-known/assetlinks.json
APP_ASSETLINKS_FINGERPRINTS=
ANDROID_PACKAGE_NAME=family.bank.app
