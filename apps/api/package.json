{
  "name": "@botf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@botf/shared": "workspace:*",
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "argon2": "^0.45.0",
    "croner": "^10.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nanoid": "^6.0.0",
    "openid-client": "^6.8.0",
    "pg": "^8.23.0",
    "pino": "^10.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.0",
    "oauth2-mock-server": "^9.2.0",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
