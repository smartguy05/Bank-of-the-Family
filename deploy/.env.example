# Copy to deploy/.env. Values here are read by docker-compose.yml and passed to the app container.
APP_PORT=3000
POSTGRES_PASSWORD=change-me
APP_URL=https://bank.example.com
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTHENTIK_ISSUER=https://auth.example.com/application/o/bank-of-the-family/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_PARENT_GROUP=bank-parents
AUTHENTIK_API_URL=https://auth.example.com/api/v3
AUTHENTIK_API_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
APP_ASSETLINKS_FINGERPRINTS=
ANDROID_PACKAGE_NAME=family.bank.app
